# ── App Database (PostgreSQL) ─────────────────────────────────────────────────
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=dataguard
APP_DB_USER=dataguard
APP_DB_PASSWORD=your_db_password_here
APP_DB_SSL=false          # Set true for Supabase / cloud databases

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex
JWT_SECRET=replace_with_64_char_hex

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ── Optional: LLM-enhanced PII classification (Gemini 2.5 Flash) ──────────────
# GEMINI_API_KEY=your_gemini_api_key

# ── Optional: Redis job queue + caching ───────────────────────────────────────
# REDIS_URL=redis://localhost:6379
