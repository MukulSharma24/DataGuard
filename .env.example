# ─────────────────────────────────────────────────────────────
# DataGuard — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application Database ──────────────────────────────────────
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=dataguard
APP_DB_USER=dataguard
APP_DB_PASSWORD=dataguard_secret

# ── Encryption key for stored connection credentials ──────────
# Generate with: openssl rand -hex 32
# Must be consistent — changing this breaks existing sources.
ENCRYPTION_KEY=replace_with_32_byte_hex_string

# ── Backend server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Frontend CORS origin ──────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Next.js frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
